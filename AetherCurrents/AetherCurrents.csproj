<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>AetherCurrents</AssemblyName>
    <RootNamespace>AetherCurrents</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
